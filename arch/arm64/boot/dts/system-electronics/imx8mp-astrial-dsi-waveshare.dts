/dts-v1/;

#include "imx8mp-astrial-base.dtsi"

&iomuxc {
	pinctrl-0 = <
		&pinctrl_hog
		&pinctrl_gpio_flexcan2
		&pinctrl_gpio_spi2
		&pinctrl_gpio_uart3
		&pinctrl_gpio_sdhc1
	>;
};

&mipi_dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "waveshare,10.1inch-panel";
		reg = <0>;
		i2c-bus = <&i2c2>;
		status = "okay";
	};
};

/*
 * Capacitive touch (Goodix GT9271) on the Waveshare panel control I2C (i2c2,
 * same bus as the panel MCU). The touch INT is NOT routed to the SoC on this
 * carrier -> no "interrupts" here: client->irq is 0 and the (patched) goodix
 * driver falls back to polling the coordinates over I2C (see goodix.c,
 * GOODIX_POLL_INTERVAL_MS). No reset either (the controller already answers at
 * 0x14). The touch is rotated 90 deg vs the display -> swap X/Y and invert X so
 * raw maps to the 1280x800 landscape panel (same mapping as the imx95 Astrial).
 */
&i2c2 {
	touchscreen@14 {
		compatible = "goodix,gt911";
		reg = <0x14>;
		touchscreen-swapped-x-y;
		touchscreen-inverted-x;
	};
};
